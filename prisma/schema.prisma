generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  createdAt     DateTime  @default(now())
  emailVerified Boolean   @default(false)
  image         String?
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(USER)
  accounts      Account[]
  analyticsEvents AnalyticsEvent[]
  bookings      Booking[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Trip {
  id              String        @id @default(cuid())
  city            String
  priceCents      Int
  createdAt       DateTime      @default(now())
  endDate         DateTime?
  imageUrl        String        @default("/images/placeholder.svg")
  location        String?
  maxGuests       Int?
  startDate       DateTime?
  updatedAt       DateTime      @updatedAt
  title           Json
  description     Json?
  highlights      Json
  isPublished     Boolean       @default(true)
  childrenAllowed Boolean       @default(true)
  durationDays    Int           @default(1)
  physicalLevel   PhysicalLevel @default(LIGHT)
  // RT-100 (Sprint 9): who operates the tour. Existing rows are UNCLASSIFIED until the Owner classifies them; UNCLASSIFIED
  // is an internal state and is never shown to visitors. DB CHECK: operationType = PARTNER <=> partnerId IS NOT NULL.
  operationType   OperationType @default(UNCLASSIFIED)
  partnerId       String?
  partner         Partner?      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  commercial      TripCommercial?
  analyticsEvents  AnalyticsEvent[]
  bookings        Booking[]
  schedules       TripSchedule[]
  translationLogs TranslationJobLog[]
  // RT-113: structured tour content (Sprint 10). All optional/additive; public output gated by status/rights.
  content         TripContent?
  itinerary       TripItineraryStop[]
  images          TripImage[]
  faq             TripFaqItem[]

  @@index([partnerId])
}

// RT-100: public-safe partner identity. No contact, contract or financial data on this table.
model Partner {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  // Safe default: a partner stays INACTIVE (its tours are hidden by the public gate) until explicitly activated.
  status      PartnerStatus @default(INACTIVE)
  // Approved 'Operated by ...' wording per locale ({ pt, en, es }); null = no label is shown.
  publicLabel Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  trips       Trip[]
}

// RT-100: PRIVATE commercial data for a trip. Never selected by any public reader, API or page.
// Every business field is nullable; a row may be empty. No value is assumed (Owner decision 2026-10-13).
model TripCommercial {
  id                String                 @id @default(cuid())
  tripId            String                 @unique
  trip              Trip                   @relation(fields: [tripId], references: [id], onDelete: Restrict)
  priceSource       PriceSource?
  // Free text identifying the tariff document and version; implies no number.
  tariffReference   String?
  tariffConfirmedAt DateTime?
  tariffConfirmedBy String?
  // ISO 4217. Required (CHECK) whenever a rate amount is stored.
  currency          String?
  // No default and no value field on purpose: markup/commission is not presumed until the contract exists.
  remunerationModel RemunerationModel?
  recordStatus      CommercialRecordStatus @default(UNCONFIRMED)
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  rates             TripCommercialRate[]
}

// RT-100: PRIVATE rate rows, prepared for child rates, seasonality and price categories. Created empty.
model TripCommercialRate {
  id               String         @id @default(cuid())
  tripCommercialId String
  tripCommercial   TripCommercial @relation(fields: [tripCommercialId], references: [id], onDelete: Cascade)
  // Price category code (e.g. adult / child / other); free text so categories can evolve without a migration.
  category         String
  ageMin           Int?
  ageMax           Int?
  seasonLabel      String?
  validFrom        DateTime?
  validTo          DateTime?
  netAmountCents   Int?
  currency         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tripCommercialId])
}

model TripSchedule {
  id                  String         @id @default(cuid())
  tripId              String
  startAt             DateTime
  endAt               DateTime?
  capacity            Int
  pricePerPersonCents Int
  status              String         @default("OPEN") // OPEN, CLOSED
  trip                Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bookings            Booking[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([tripId, startAt])
}

model Booking {
  id              String         @id @default(cuid())
  userId          String
  tripId          String
  scheduleId      String?
  status          BookingStatus  @default(PENDING)
  paymentStatus   PaymentStatus  @default(UNPAID)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  guestCount      Int            @default(1)
  totalPriceCents Int            @default(0)
  schedule        TripSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyticsEvents AnalyticsEvent[]
  emailLogs       EmailLog[]
  paymentAttempts PaymentAttempt[]

  @@index([userId, createdAt])
  @@index([tripId])
  @@index([userId, tripId, scheduleId])
  @@index([status])
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  bookingId         String
  provider          String
  providerPaymentId String?
  amountCents       Int
  currency          String               @default("BRL")
  status            PaymentAttemptStatus @default(CREATED)
  checkoutUrl       String?
  providerEventId   String?
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  analyticsEvents    AnalyticsEvent[]
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@index([provider, providerPaymentId])
}

model AnalyticsEvent {
  id               String             @id @default(cuid())
  type             AnalyticsEventType
  userId           String?
  tripId           String?
  bookingId        String?
  paymentAttemptId String?
  sessionId        String?
  path             String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  trip             Trip?              @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking          Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  paymentAttempt   PaymentAttempt?    @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([tripId, type, createdAt])
  @@index([bookingId, type, createdAt])
  @@index([sessionId, createdAt])
}

model EmailLog {
  id                String        @id @default(cuid())
  to                String
  template          EmailTemplate
  status            EmailStatus   @default(QUEUED)
  bookingId         String?
  booking           Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  providerMessageId String?
  error             String?
  createdAt         DateTime      @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model TranslationJobLog {
  id           String               @id @default(cuid())
  tripId       String?
  entityType   String
  operation    TranslationOperation
  provider     String
  status       TranslationJobStatus
  sourceLocale String
  metadata     Json?
  createdAt    DateTime             @default(now())
  trip         Trip?                @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([status, createdAt])
}

enum OperationType {
  UNCLASSIFIED
  OWN
  PARTNER
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

enum PriceSource {
  OWNER_SET
  PARTNER_TARIFF
  CONTRACT
}

enum RemunerationModel {
  MARKUP
  COMMISSION
}

enum CommercialRecordStatus {
  UNCONFIRMED
  CONFIRMED
  APPROVED_FOR_PUBLICATION
}

enum PhysicalLevel {
  LIGHT
  MODERATE
  HARD
  EXTREME
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIAL
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum AnalyticsEventType {
  TOUR_VIEWED
  RESERVE_CLICKED
  CHECKOUT_STARTED
  PIX_GENERATED
  PAYMENT_CONFIRMED
}

enum TranslationOperation {
  CREATE
  UPDATE
}

enum TranslationJobStatus {
  SUCCESS
  PARTIAL_FALLBACK
  FULL_FALLBACK
}

enum EmailTemplate {
  BOOKING_CONFIRMED
  PAYMENT_CONFIRMED
}

// RT-113 (RT-RB-S10-03): structured content for a tour, additive. One row per Trip. Localized fields are JSON objects
// keyed by locale ({ "pt": ..., "en": ..., "es": ... }). Nothing here is shown publicly unless status = OWNER_APPROVED
// (lib/catalog/tour-content.ts). No price lives here: prices stay on Trip and change only by Owner decision.
model TripContent {
  tripId          String            @id
  trip            Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status          TripContentStatus @default(DRAFT)
  /// Free text: where every fact came from (Owner intake reference, date). "MOCK" for fictitious development data.
  source          String?
  summary         Json?
  description     Json?
  durationLabel   Json?
  meetingPoint    Json?
  startTimeNote   Json?
  /// ISO 639-1 codes of the languages the tour is offered in, e.g. ["pt","en","es"].
  languages       String[]          @default([])
  inclusions      Json?
  exclusions      Json?
  requirements    Json?
  accessibility   Json?
  weatherPolicy   Json?
  /// RT-113 complement (17/10/2026): public operating conditions (route changes, confirmation) and optional
  /// third-party services note, localized {pt,en,es}. Public only through the content gate (status OWNER_APPROVED).
  operationalConditions Json?
  optionalServicesNote  Json?
  approvedAt      DateTime?
  /// RT-119 approval fingerprint (SHA-256 of the public content when the Owner approved it). The public gate publishes
  /// only when it equals the fingerprint of the current content, so any later edit requires a new review. NULL on DRAFT.
  approvedContentHash String?
  /// RT-119 durable invalidation (DB triggers): when approved content or its itinerary/FAQ/media change, the database
  /// sets status back to DRAFT and records when/why. Restoring old values never restores the approval.
  approvalInvalidatedAt      DateTime?
  approvalInvalidationReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// RT-113: ordered itinerary stops of a tour.
model TripItineraryStop {
  id              String   @id @default(cuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position        Int
  title           Json
  description     Json?
  durationMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tripId, position])
}

/// RT-113 complement: ordered FAQ of a tour, localized question/answer {pt,en,es}. Public only through the content gate.
model TripFaqItem {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position  Int
  question  Json
  answer    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, position])
}

// RT-113: ordered gallery images of a tour. Only images with recorded rights are shown publicly.
model TripImage {
  id           String              @id @default(cuid())
  tripId       String
  trip         Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position     Int
  src          String
  alt          Json
  isCover      Boolean             @default(false)
  /// Optional focal point (0–1) used when a frame must crop (cover/thumbnail); the main view never crops (RT-114).
  focalX       Float?
  focalY       Float?
  rightsStatus TripImageRightsStatus @default(UNVERIFIED)
  /// Author, consent of identifiable people, licence reference (RT-79 / RT-116 rights register).
  rightsNote   String?
  /// RT-113 complement: the same table holds videos (no parallel gallery). VIDEO requires posterSrc and is never the
  /// cover; IMAGE rows carry no video fields (DB CHECKs). Rights are decided by rightsStatus only, never by credit.
  mediaType       TripMediaType @default(IMAGE)
  posterSrc       String?
  /// Lighter rendition for small screens (videos only).
  mobileSrc       String?
  durationSeconds Float?
  /// Public credit, localized {pt,en,es} (e.g. a visible mural inscription). Not a rights approval.
  credit          Json?
  /// RT-119 media publication authorization: set ONLY by the explicit approval act, for items whose rights are verified
  /// at that moment; cleared by DB triggers on any rights or media change. Public only when it matches the content's
  /// approvedAt AND rights are verified now (editorial approval, rights and publication kept separate).
  publicationApprovedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tripId, position])
}

enum TripContentStatus {
  DRAFT
  OWNER_APPROVED
}

enum TripMediaType {
  IMAGE
  VIDEO
}

enum TripImageRightsStatus {
  UNVERIFIED
  OWNER_ATTESTED
  LICENSED
}
