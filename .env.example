# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ricktravel?schema=public"

# Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Email
RESEND_API_KEY="replace-with-resend-api-key"

# Mercado Pago
MP_ACCESS_TOKEN="replace-with-mercado-pago-access-token"
MP_WEBHOOK_SECRET="optional-webhook-signature-secret"

# E2E
E2E_ADMIN_EMAIL="e2e-admin@ricktravel.local"
E2E_ADMIN_PASSWORD="replace-with-e2e-admin-password"
E2E_USER_EMAIL="e2e-user@ricktravel.local"
E2E_USER_PASSWORD="replace-with-e2e-user-password"

# Rebuild Lab (RT-RB-S0-04)
# Leave unset to keep the default: enabled in local development and unavailable
# when NODE_ENV=production, including Vercel Preview and Production.
# Set to true/1/on to expose it explicitly, or false/0/off to force it off.
# Scope REBUILD_LAB_ENABLED to Preview only if Preview should be enabled without Production.
# REBUILD_LAB_ENABLED="true"

# AI Concierge runtime V1 (RT-67) — SERVER ONLY. Never use NEXT_PUBLIC_* for these.
# Production API stays disabled until the RT-75 Owner gate. Model below is a DEVELOPMENT / VALIDATION model only.
# OPENAI_API_KEY=
# OPENAI_CONCIERGE_VECTOR_STORE_ID=   # RT-69 hosted store (provider ID, keep private)
# OPENAI_CONCIERGE_MODEL=

# Shared rate limiter (RT-72 Concierge + RT-82 public forms) — SERVER ONLY, never NEXT_PUBLIC_*.
# Upstash Redis FREE plan only (Owner decision: USD 0/month, no paid upgrade). Not provisioned yet: until these exist the
# public forms use a counted per-instance fallback and the Concierge model path is denied (fail closed).
# UPSTASH_REDIS_REST_URL=      # https://<name>.upstash.io (the KV_REST_API_URL / KV_REST_API_TOKEN aliases are also read)
# UPSTASH_REDIS_REST_TOKEN=    # mark as Sensitive in Vercel
# RATE_LIMIT_HMAC_SECRET=      # >= 32 random characters; hashes identifiers before they reach Redis
# AI_CONCIERGE_RATE_LIMITS=    # JSON {"burst":{"limit":N,"windowSeconds":S},"session":{...},"global":{...}}; no defaults on purpose
# AI_CONCIERGE_KILL_SWITCH=    # true = deny every Concierge request instantly (no Redis call)
